# =====================================================================
# killa-web — variables de entorno
#
# Copiar a `.env.local` y completar. `.env*` está en .gitignore: NINGÚN valor
# real de estas claves se commitea. Este archivo sólo lleva los nombres.
# =====================================================================

# --- Supabase --------------------------------------------------------
# Proyecto > Settings > API. Las dos son públicas: viajan al navegador y sin
# RLS no habilitan nada. La seguridad la dan las policies, no el secreto.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Con el stack local (`npm run supabase:start`) los valores son:
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   NEXT_PUBLIC_SUPABASE_ANON_KEY=<la "Publishable" que imprime `supabase status`>

# --- Lo que NO va acá ------------------------------------------------
# La clave `service_role` / `secret` salta la RLS: en el navegador equivale a
# entregar la base entera. La Etapa 1 NO la necesita — todo escribe con la
# sesión del editor. Si alguna vez hace falta (un job, un import masivo), va
# como variable de servidor SIN prefijo NEXT_PUBLIC_ y sólo en un archivo con
# `import "server-only"`.

# --- Sitio -----------------------------------------------------------
# Dominio definitivo para las URLs absolutas de Open Graph. En Vercel se puede
# omitir: cae a VERCEL_PROJECT_PRODUCTION_URL (ver app/layout.tsx).
NEXT_PUBLIC_SITE_URL=
